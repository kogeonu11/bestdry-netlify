# Local development only. Generate an unpredictable password (16+ characters) and never commit .env.
# ADMIN_PASSWORD=
# Netlify Functions secret only. Generate separately with openssl rand -hex 32.
# ADMIN_RECOVERY_CODE=
# Production Functions only. Set the destination, verified sender and Resend API key.
# ADMIN_RECOVERY_EMAIL=
# RECOVERY_FROM_EMAIL=
# RESEND_API_KEY=
# Custom canonical domain, e.g. https://www.example.com . Configure this in Netlify environment variables.
# PUBLIC_SITE_URL=
# Public HTML verification values (content attribute only). Configure in Netlify Functions scope.
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
